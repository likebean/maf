# openai (default): OpenAI-compatible Chat Completions, e.g. LM Studio
CHAT_PROVIDER=openai
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_MODEL=qwen3.8-27b@4bit
OPENAI_API_KEY=not-needed

